#!/bin/sh
# Conformance server launcher. stdout is reserved for the handshake bytes,
# so nothing else may be written there. Run `mix deps.get && mix compile`
# first (run.sh does this), since the runner starts many servers in parallel.
set -e
cd "$(dirname "$0")/.."
exec mix run --no-compile --no-deps-check --no-halt -e 'Conformance.Main.run()'
